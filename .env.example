# ── MedAssist AI API — Environment Configuration Template ───────────────────
# Copy this file to .env and adjust values for your local or production environment.
# DO NOT commit the actual .env file to version control.

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="MedAssist AI API"
API_VERSION="2.0.0"
DEBUG=False

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://medassist:change_this_password@localhost:5432/medassist_db

# ── Object Storage (MinIO / S3) ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=medassist
MINIO_SECRET_KEY=change_this_minio_secret
MINIO_SECURE=False
MINIO_BUCKET_ANALYSES=medassist-analyses

# ── Security & Authentication (JWT) ─────────────────────────────────────────
# Generate a secure random string (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
QR_TOKEN_EXPIRE_DAYS=30

# ── Initial Super Admin Account ─────────────────────────────────────────────
# Automatically seeded into the database on first startup if no admin exists
INITIAL_ADMIN_EMAIL=admin@medassist.dz
INITIAL_ADMIN_PASSWORD=ChangeThisPassword2026!

# ── Deep Learning Model Artifacts (V6.0) ────────────────────────────────────
# Paths relative to the backend root directory
MODEL_PATH=app/ml_models/multimodal_model.pth
LE_DIAGNOSTIC_PATH=app/ml_models/diagnostic_encoder.pkl
IMPUTER_PATH=app/ml_models/imputer.pkl
SCALER_PATH=app/ml_models/scaler.pkl
THRESHOLDS_PATH=app/ml_models/thresholds_V6.0.json

# ── Server Binding ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS Origins ────────────────────────────────────────────────────────────
# Comma-separated list of allowed web/mobile origin origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ── Upload Limits ───────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

