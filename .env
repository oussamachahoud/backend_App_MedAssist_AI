# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="MedAssist AI API"
API_VERSION="2.0.0"
DEBUG=False

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://medassist:secret@localhost:5432/medassist_db

# ── Object Storage (MinIO) ─────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=medassist
MINIO_SECRET_KEY=medassist_secret
MINIO_SECURE=False
MINIO_BUCKET_ANALYSES=medassist-analyses

# ── Security & JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=medassist_super_secret_jwt_key_v2_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
QR_TOKEN_EXPIRE_DAYS=30

# ── Initial Admin Seed (override in production) ──────────────────────────────
INITIAL_ADMIN_EMAIL=admin@medassist.dz
INITIAL_ADMIN_PASSWORD=Admin@MedAssist2026!

# ── Model Paths (V6.0 artifacts) ────────────────────────────────────────────
MODEL_PATH=app/ml_models/multimodal_model.pth
LE_DIAGNOSTIC_PATH=app/ml_models/diagnostic_encoder.pkl
IMPUTER_PATH=app/ml_models/imputer.pkl
SCALER_PATH=app/ml_models/scaler.pkl
THRESHOLDS_PATH=app/ml_models/thresholds_V6.0.json

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ── Upload Limits ───────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
